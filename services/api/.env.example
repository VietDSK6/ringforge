# Sao chép thành .env (đã gitignore). Mặc định trong app/config.py đủ cho chạy local.
APP_ENV=dev
# Danh sách origin được phép gọi API, phân tách bằng dấu phẩy (không dùng *)
CORS_ORIGINS=http://localhost:3000
# Giới hạn tần suất gọi API theo IP (yêu cầu/phút). 0 = tắt
RATE_LIMIT_PER_MIN=60
# LLM qua OpenRouter (key sk-or-...). Bỏ trống LLM_API_KEY = chế độ dự phòng không AI
LLM_PROVIDER=openrouter
LLM_API_KEY=
LLM_MODEL=openai/gpt-6-luna
LLM_MODEL_FALLBACK=openai/gpt-4o-mini
