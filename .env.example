# Danh sách đầy đủ biến môi trường (docs/06 mục 5). Không bao giờ commit giá trị thật.
# Mỗi app có .env.example riêng: services/api/.env.example, apps/web/.env.example

# ===== API (services/api) =====
# dev | staging | production
APP_ENV=dev
# Origin được phép gọi API, phân tách bằng dấu phẩy, không dùng *
CORS_ORIGINS=http://localhost:3000
# Postgres (Supabase/Neon). Bỏ trống = SQLite trong thư mục tạm (mất khi restart). postgres:// tự đổi sang driver psycopg
DATABASE_URL=
# LLM — từ Ngày 2; key chỉ đặt trên server, không bao giờ đưa vào web
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_MODEL_FALLBACK=
LLM_DAILY_CALL_CAP=500
# Số lời gọi LLM tối đa mỗi phiên/ngày (docs/05)
LLM_SESSION_DAILY_CAP=40

# ===== Web (apps/web) =====
# Nhúng vào bundle lúc build: đổi giá trị thì phải build/deploy lại
NEXT_PUBLIC_API_URL=http://localhost:8000
