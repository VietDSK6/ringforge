{
  "id": "T-10",
  "requirement_vi": "Thanh toán QR cho merchant đã xác minh thì miễn xác thực bổ sung.",
  "category": "REG_BYPASS",
  "gold_status": "OK",
  "gold_rule": {
    "when": {
      "all": [
        {
          "field": "channel",
          "op": "==",
          "value": "MERCHANT_QR"
        },
        {
          "field": "receiver_is_verified_merchant",
          "op": "==",
          "value": true
        }
      ]
    },
    "then": {
      "exempt_auth": true
    }
  },
  "gold_assumptions": [],
  "gold_violations": [
    "INV-AUTH-01",
    "INV-AUTH-02"
  ],
  "gold_repair_must": {
    "pass_invariants": true,
    "scope_subset_of_original": true,
    "min_coverage_bp": 9000
  },
  "notes": "Kênh QR không chồng FR-02 nên không có VC-06."
}
